rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /quotes/{quoteId} {
      // Owner can read/write only their own quotes.
      // Admins (custom claim admin: true) can read everything, for reporting.
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        request.auth.token.admin == true
      );

      // Creation: the backend (Cloud Run, using the Admin SDK / a service
      // account) bypasses these rules entirely — they only govern direct
      // client SDK access, which admin.html and index.html don't currently
      // use for writes. This allows it defensively in case a client write
      // path is added later, but still enforces uid ownership.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;

      // Updates from the client are not expected (the backend does all
      // writes via /extract-and-quote and /recalculate) — deny by default.
      allow update, delete: if false;
    }

    // Everything else: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
